# Copy to .env next to docker-compose.yml. Nothing here is committed.

# Public hostnames, both ingress rules of one Cloudflare tunnel.
BOARD_HOST=board.example.com
MARSHAL_HOST=marshal.example.com

# From the Cloudflare dashboard: Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
CLOUDFLARE_TUNNEL_TOKEN=

# Workman
WORKMAN_JWT_SECRET=            # openssl rand -hex 32
POSTGRES_PASSWORD=             # openssl rand -hex 16
WORKMAN_ENABLE_REGISTRATION=false
WORKMAN_LEASE_STALE_AFTER=4h
WORKMAN_LEASE_AUTO_RELEASE_AFTER=0
TZ=UTC

# Marshal
# Absolute path on this machine of a clone of the coordinated repository
# (the one with .veans.yml and .marshal.yml committed). Marshal only reads it.
REPO_PATH=/srv/capyard
# The Marshal bot's token: `marshal setup` stores it in the credential store on
# the machine that ran setup; copy it here for the container (or run setup
# inside the container once: docker compose run --rm marshal setup --token ...).
MARSHAL_TOKEN=
# Signs the board's webhook deliveries. `marshal setup` generates one into
# .marshal/webhook-secret; put the same value here.
MARSHAL_WEBHOOK_SECRET=
# Discord channel webhook (Server settings -> Integrations -> Webhooks -> New).
DISCORD_WEBHOOK_URL=
MARSHAL_BASE_BRANCH=origin/main
MARSHAL_SPEC_REV=origin/main

# Optional: prebuilt images instead of building locally.
# WORKMAN_IMAGE=ghcr.io/epycd/workman:latest
# MARSHAL_IMAGE=ghcr.io/epycd/marshal:latest
